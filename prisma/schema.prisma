generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())

  accounts     Account[]
  transactions Transaction[]
  debts        Debt[]
}

model Account {
  id          String   @id @default(uuid())
  userId      String
  pluggyId    String?
  name        String
  bank        String
  type        String
  balance     Int      // centavos — ver FIN-015 em docs/BACKLOG_DETAIL.md
  limit       Int?     // centavos
  dueDay      Int?
  closingDay  Int?
  pendingBill Int?     // centavos
  color       String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  transactions Transaction[]
  debts       Debt[]   
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  pluggyId    String?
  importHash  String?  // chave de deduplicação de importações manuais (CSV/OFX) — ver FIN-003
  name        String
  category    String
  date        String
  amount      Int      // centavos — ver FIN-015
  paymentType String   @default("debit")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  account     Account? @relation(fields: [accountId], references: [id])

  @@index([userId, importHash])
}

model Debt {
  id                String     @id @default(uuid())
  userId            String
  accountId         String?
  name              String
  description       String?
  category          String
  totalAmount       Int      // centavos — ver FIN-015
  paidAmount        Int      // centavos
  monthlyPayment    Int      // centavos
  totalInstallments Int
  paidInstallments  Int
  nextDueDate       String
  interestRate      Float?   // % ao mês — NÃO é valor monetário, permanece Float
  createdAt         DateTime   @default(now())

  user              User       @relation(fields: [userId], references: [id])
  account           Account?   @relation(fields: [accountId], references: [id])
  subItems          DebtItem[]
}

model DebtItem {
  id          String   @id @default(uuid())
  debtId      String
  name        String
  amount      Int      // centavos — ver FIN-015
  date        String

  debt        Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
}
