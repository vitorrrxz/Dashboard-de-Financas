generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())

  accounts     Account[]
  transactions Transaction[]
  debts        Debt[]
  budgets      Budget[]
  goals        Goal[]
  recurring    RecurringTransaction[]
  notifications Notification[]
  investments  Investment[]
}

model Account {
  id          String   @id @default(uuid())
  userId      String
  pluggyId    String?
  name        String
  bank        String
  type        String
  balance     Int      // centavos — ver FIN-015 em docs/BACKLOG_DETAIL.md
  limit       Int?     // centavos
  dueDay      Int?
  closingDay  Int?
  pendingBill Int?     // centavos
  // FIN-074 — moeda de balance/limit/pendingBill (ISO 4217). O padrão BRL mantém todas as
  // contas existentes como estavam.
  currency    String   @default("BRL")
  color       String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  transactions Transaction[]
  debts       Debt[]
  recurring   RecurringTransaction[]
  investments Investment[]

  // Toda listagem filtra por userId; o sync Pluggy busca por (userId, pluggyId) — ver FIN-019.
  @@index([userId])
  // Reforça a idempotência do sync Pluggy a nível de banco, não só de aplicação — evita
  // condição de corrida se duas sincronizações rodarem em paralelo (ver FIN-021).
  // SQLite/Prisma permitem múltiplos NULL num índice único, então contas sem pluggyId
  // (a maioria, criadas manualmente) não são afetadas.
  @@unique([userId, pluggyId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  pluggyId    String?
  importHash  String?  // chave de deduplicação de importações manuais (CSV/OFX) — ver FIN-003
  name        String
  category    String
  date        String
  amount      Int      // centavos — ver FIN-015
  // FIN-074 — sempre a moeda da conta vinculada (real, sem conta): o servidor deriva, o
  // cliente não escolhe. Assim uma transação nunca fica numa moeda diferente da própria conta.
  currency    String   @default("BRL")
  paymentType String   @default("debit")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  account     Account? @relation(fields: [accountId], references: [id])

  // ver FIN-019 em docs/BACKLOG_DETAIL.md
  @@index([userId, date])
  // Reforça a deduplicação de importação manual (CSV/OFX) a nível de banco, não só de
  // aplicação — evita duplicatas se o usuário disparar duas importações do mesmo arquivo
  // em paralelo (ex. duplo clique). SQLite/Prisma permitem múltiplos NULL num índice
  // único, então transações não-importadas (criadas manualmente ou via Pluggy, sem
  // importHash) não são afetadas. Ver nota de implementação em FIN-003.
  @@unique([userId, importHash])
  // Idempotência do sync Pluggy a nível de banco — ver FIN-021.
  @@unique([userId, pluggyId])
}

model Debt {
  id                String     @id @default(uuid())
  userId            String
  accountId         String?
  name              String
  description       String?
  category          String
  totalAmount       Int      // centavos — ver FIN-015
  paidAmount        Int      // centavos
  monthlyPayment    Int      // centavos
  totalInstallments Int
  paidInstallments  Int
  nextDueDate       String
  interestRate      Float?   // % ao mês — NÃO é valor monetário, permanece Float
  createdAt         DateTime   @default(now())

  user              User       @relation(fields: [userId], references: [id])
  account           Account?   @relation(fields: [accountId], references: [id])
  subItems          DebtItem[]

  @@index([userId]) // ver FIN-019
}

// FIN-042 — orçamento mensal por categoria (Fase 3). Um limite por (usuário, categoria) —
// a constraint única evita dois orçamentos concorrentes para a mesma categoria, o que
// tornaria ambíguo qual limite vale no cálculo de progresso (ver FIN-044).
model Budget {
  id           String   @id @default(uuid())
  userId       String
  category     String
  monthlyLimit Int      // centavos — ver FIN-015 em docs/BACKLOG_DETAIL.md
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@index([userId]) // ver FIN-019
  @@unique([userId, category])
}

// FIN-049 — meta financeira (Fase 4): quanto o usuário quer juntar até uma data.
// `currentAmount` é atualizado manualmente pelo usuário (aportes), não derivado de
// transações — vincular meta a conta/transação específica ficou fora do escopo desta fase.
model Goal {
  id            String   @id @default(uuid())
  userId        String
  name          String
  targetAmount  Int      // centavos — ver FIN-015 em docs/BACKLOG_DETAIL.md
  currentAmount Int      @default(0) // centavos já acumulados
  targetDate    String   // ISO YYYY-MM-DD, mesma convenção de Debt.nextDueDate
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])

  @@index([userId]) // ver FIN-019
}

// FIN-053 — transação recorrente (Fase 4): modela a recorrência em si, não as transações
// geradas. `nextOccurrence` é o ponteiro de até onde já foi lançado; o endpoint de
// processamento (FIN-054) cria as `Transaction` reais cujas ocorrências já passaram e
// avança esse ponteiro.
model RecurringTransaction {
  id             String   @id @default(uuid())
  userId         String
  accountId      String?
  name           String
  category       String
  amount         Int      // centavos; negativo = despesa, positivo = receita (igual a Transaction)
  frequency      String   // 'weekly' | 'monthly' | 'yearly' — validado por Zod em server.js
  nextOccurrence String   // ISO YYYY-MM-DD
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
  account        Account? @relation(fields: [accountId], references: [id])

  @@index([userId]) // ver FIN-019
}

model DebtItem {
  id          String   @id @default(uuid())
  debtId      String
  name        String
  amount      Int      // centavos — ver FIN-015
  date        String

  debt        Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
}

// FIN-065 — notificação da central do sino (Fase 6). `dedupeKey` identifica a ocorrência que
// gerou o aviso (ex.: a parcela de uma dívida com vencimento em tal data): a constraint única
// garante, no banco, que rodar a geração várias vezes — a cada carregamento do app — não
// duplique o aviso da mesma ocorrência. Mesmo padrão de `Transaction.importHash` (FIN-003).
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'debt_due' | 'debt_overdue' | 'bill_due' | 'unusual_spending'
  title     String
  message   String
  dedupeKey String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  // A central lista por usuário, com as não lidas primeiro, e conta as não lidas.
  @@index([userId, read])
  @@unique([userId, dedupeKey])
}

// FIN-070 — posição da carteira de investimentos (Fase 7). Valores em centavos, como o resto
// do schema. `currentValue` é informado pelo usuário — não há cotação automática nesta fase —,
// por isso `updatedAt`: a carteira mostra há quanto tempo cada valor não é atualizado.
// `accountId` aponta a conta onde a aplicação está (corretora, banco); ao excluir a conta, o
// vínculo vira NULL e a posição continua na carteira (ver FIN-073 para o efeito no patrimônio).
model Investment {
  id             String   @id @default(uuid())
  userId         String
  accountId      String?
  name           String
  type           String   // 'fixed_income' | 'stocks' | 'funds' | 'crypto' | 'other' — validado por Zod em server.js
  amountInvested Int      // centavos — quanto foi aplicado
  currentValue   Int      // centavos — quanto a posição vale hoje
  // FIN-074 — moeda dos dois valores (ISO 4217). Independente da conta vinculada: uma
  // corretora em real pode custodiar um ativo cotado em dólar.
  currency       String   @default("BRL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
  account        Account? @relation(fields: [accountId], references: [id])

  @@index([userId]) // ver FIN-019
}
