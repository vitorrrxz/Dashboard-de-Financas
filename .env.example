# URL de conexão do banco de dados (SQLite local)
DATABASE_URL="file:./dev.db"
# Na Vercel (FIN-120), o banco é o do Turso: DATABASE_URL="libsql://<banco>-<conta>.turso.io" e o token
# de acesso abaixo (`turso db tokens create <banco>`). Sem efeito com DATABASE_URL local (`file:`).
# TURSO_AUTH_TOKEN=""

# Segredo do Better Auth (FIN-121): assina os cookies de sessão e cifra os segredos da verificação em
# duas etapas (mínimo 32 caracteres). Guarde-o junto com o backup do banco: trocá-lo encerra todas as
# sessões e invalida a verificação em duas etapas já ativada. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
BETTER_AUTH_SECRET="sua_chave_secreta_super_segura_aqui"
# Endereço público do app (ex.: https://finflow-ashen-ten.vercel.app). Vazio no desenvolvimento: o
# Better Auth usa o endereço da própria requisição.
# BETTER_AUTH_URL=""

# Login com Google, GitHub e Microsoft (FIN-122) — opcional. Cada provedor só aparece na tela de login
# com as duas variáveis dele. URL de retorno a cadastrar em cada app OAuth:
#   <endereço da API>/api/auth/callback/<google|github|microsoft>
#   (desenvolvimento: http://localhost:3001/api/auth/callback/google; ver README, "Login com Google...")
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# Locatário do Microsoft Entra: "common" (padrão) aceita contas pessoais e de trabalho/escola.
# MICROSOFT_TENANT_ID="common"

# Verificação em duas etapas obrigatória (FIN-123) — ligada por padrão. "false" a torna opcional.
# TWO_FACTOR_REQUIRED="false"

# Credenciais da Pluggy (Open Finance) — necessárias apenas para conectar bancos reais
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Origem do frontend permitida pelo CORS da API (ver FIN-009). Padrão: localhost do Vite.
FRONTEND_URL="http://localhost:5173"

# Base URL da API usada pelo frontend (ver FIN-025). Precisa do prefixo VITE_ para o Vite
# expor a variável ao código do navegador via `import.meta.env`. Padrão: backend local. Vazia
# (VITE_API_URL=""), a API é a da própria origem da página — é assim que o build do Docker sai (FIN-108).
VITE_API_URL="http://localhost:3001"

# Build do frontend servido pela própria API, na mesma origem (FIN-108). O Docker já define (/app/dist);
# fora dele, depois de `npm run build` com VITE_API_URL="", use FRONTEND_DIR=Frontend/dist. Sem ela, a API não
# serve o frontend — no desenvolvimento, quem serve é o Vite.
# FRONTEND_DIR=Frontend/dist

# Notificações automáticas (FIN-067/FIN-069) — todas opcionais; sem elas valem os padrões
# abaixo. Um valor inválido é ignorado (com aviso no console) e o padrão é usado.
# Dias de antecedência para avisar sobre parcela de dívida ou fatura de cartão (0 a 60).
NOTIFY_DUE_SOON_DAYS=7
# Meses anteriores usados na média de gasto por categoria (2 a 12).
UNUSUAL_SPENDING_MONTHS=3
# Quanto acima da média o gasto do mês precisa ficar para gerar alerta (0.5 = 50%).
UNUSUAL_SPENDING_THRESHOLD=0.5
# Diferença mínima, em centavos, entre o gasto do mês e a média (5000 = R$ 50,00).
UNUSUAL_SPENDING_MIN_CENTS=5000

# Câmbio para os totais em real (FIN-075) — opcional. Endereço de uma instância da API
# Frankfurter (cotações do Banco Central Europeu, sem chave de acesso). Sem a variável, usa o
# serviço público; troque para uma instância própria se preferir não depender dele.
EXCHANGE_RATES_URL=https://api.frankfurter.dev/v1

# Backup automático do banco (FIN-102) — pasta das cópias, de preferência fora do projeto (outro
# disco ou pasta sincronizada com a nuvem). Vazia, o backup automático fica desligado; `npm run
# backup` usa as mesmas variáveis. BACKUP_KEEP = quantas cópias manter (padrão 30).
BACKUP_DIR=""
BACKUP_KEEP=30

# Desativa a tela de login (o app abre direto na conta do primeiro usuário). Só fora de produção.
# VITE_AUTH_DISABLED=true
